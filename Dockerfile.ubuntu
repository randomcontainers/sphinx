# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

ARG VERSION
# babel keeps the license of its CLDR data next to the data, outside its
# dist-info, so metadata.py does not see it.
RUN --mount=type=bind,target=/src \
    set -eu; \
    : "${VERSION:?}"; \
    if ! awk -v want="sphinx==${VERSION}" '$1 == want { found = 1 } END { exit !found }' /src/requirements.lock; then \
        echo "requirements.lock does not pin sphinx==${VERSION}" >&2; exit 1; \
    fi; \
    venv=/usr/local/lib/sphinx; \
    meta=/usr/local/share/randomcontainers/sphinx; \
    python3 -m venv "$venv"; \
    "$venv/bin/pip" install --no-cache-dir --disable-pip-version-check --no-input \
        --require-hashes --no-deps --only-binary=:all: \
        --report /tmp/pip-report.json -r /src/requirements.lock; \
    installed="$("$venv/bin/sphinx-build" --version)"; \
    if [ "$installed" != "sphinx-build ${VERSION}" ]; then \
        echo "requirements.lock installs $installed, expected sphinx-build ${VERSION}" >&2; exit 1; \
    fi; \
    for tool in sphinx-build sphinx-quickstart sphinx-apidoc sphinx-autogen rst2html; do \
        test -x "$venv/bin/$tool" || { echo "the venv has no $tool" >&2; exit 1; }; \
        ln -s "$venv/bin/$tool" "/usr/local/bin/$tool"; \
    done; \
    mkdir -p "$meta"; \
    printf '%s\n' "$VERSION" > "$meta/version"; \
    cp /src/runtime-deps.ubuntu "$meta/runtime-deps"; \
    "$venv/bin/python" /src/scripts/metadata.py /tmp/pip-report.json "$meta" /src/licenses; \
    cldr="$(echo "$venv"/lib/python3*/site-packages/babel/locale-data/LICENSE.unicode)"; \
    test -s "$cldr" || { echo "babel has no locale-data/LICENSE.unicode" >&2; exit 1; }; \
    install -D -m 644 "$cldr" "$meta/licenses/babel/locale-data/LICENSE.unicode"; \
    rm /tmp/pip-report.json

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps \
    set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /tmp/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    install -d -m 1777 /work /cache
COPY --link --from=build /usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache PYTHONUNBUFFERED=1
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "sphinx-build"]
CMD ["-M", "html", ".", "_build"]
